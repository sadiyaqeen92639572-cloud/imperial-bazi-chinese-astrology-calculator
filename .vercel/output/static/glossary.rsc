6:Td4b,{"@context":"https://schema.org","@type":"DefinedTermSet","name":"BaZi and Chinese Astrology Glossary: Core Terms Explained","description":"Search and read definitions for major terms in Chinese metaphysics, including Stems, Branches, Luck Pillars, and Five Elements.","url":"https://fourpillarscalculator.com/glossary/","hasDefinedTerm":[{"@type":"DefinedTerm","name":"Four Pillars (Sì Zhù)","description":"The fundamental four columns of a Chinese astrology birth chart: the Year Pillar, Month Pillar, Day Pillar, and Hour Pillar."},{"@type":"DefinedTerm","name":"Heavenly Stems (Tiān Gān)","description":"A decimal cycle of 10 elements composed of the Five Elements (Wood, Fire, Earth, Metal, Water) in their Yin and Yang aspects."},{"@type":"DefinedTerm","name":"Earthly Branches (Dì Zhī)","description":"A duodecimal cycle of 12 signs representing astronomical periods and animal zodiacs (Rat, Ox, Tiger, Rabbit, Dragon, Snake, Horse, Goat, Monkey, Rooster, Dog, Pig)."},{"@type":"DefinedTerm","name":"Day Master (Rì Zhǔ)","description":"The Heavenly Stem of the Day Pillar. This character is the central reference point of the entire BaZi chart."},{"@type":"DefinedTerm","name":"Ten Gods (Shí Shén)","description":"A set of 10 relationship archetypes calculated based on the day master's element and polarity compared to other stems and branches."},{"@type":"DefinedTerm","name":"Five Elements (Wǔ Xíng)","description":"The five universal forces of nature: Wood (emerald), Fire (red), Earth (amber), Metal (gray), and Water (blue)."},{"@type":"DefinedTerm","name":"Yin and Yang","description":"The complementary dual forces of the universe. Yang is active, hot, day, and rigid. Yin is receptive, cool, night, and flexible."},{"@type":"DefinedTerm","name":"Luck Pillars (Dà Yùn)","description":"Cycles of 10 years of fortune, calculated from the month pillar and determined by the polarity of the birth year and gender."},{"@type":"DefinedTerm","name":"Hidden Stems (Cáng Gān)","description":"Heavenly Stems that are \"buried\" inside Earthly Branches. Every branch has between one and three hidden stems."},{"@type":"DefinedTerm","name":"Clashes and Combinations (Chōng Hé)","description":"Frictional or supportive alignments between branches or stems (e.g. Rabbit and Rooster clash; Rat and Ox combine)."},{"@type":"DefinedTerm","name":"Useful God (Yòng Shén)","description":"The element that is most needed in the chart to bring the Day Master back into a balanced and healthy state."},{"@type":"DefinedTerm","name":"Favorable Elements (Xǐ Shén)","description":"Elements that support the Useful God or help restore balance to the Day Master."},{"@type":"DefinedTerm","name":"Chinese Solar Calendar (Wàn Nián Lì)","description":"A solar-term based calendar used in BaZi rather than the lunar calendar. The solar year begins on Lichun (around Feb 4th)."},{"@type":"DefinedTerm","name":"Solar Terms (Jié Qì)","description":"24 points in the eco-calendar that match specific longitudes of the sun, determining the exact boundaries of the 12 solar months."},{"@type":"DefinedTerm","name":"Feng Shui","description":"The Chinese metaphysical system of spatial arrangement, flow of Qi, and physical environmental alignment."},{"@type":"DefinedTerm","name":"Chinese Zodiac (Shēng Xiào)","description":"A 12-year animal cycle matching the Earthly Branch of the birth year."}]}0:{"P":null,"b":"iqdCSSMz5JN84hyj_wm0b","p":"","c":["","glossary"],"i":false,"f":[[["",{"children":["glossary",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/47cd3931c50aef3e.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark scroll-smooth","children":["$","body",null,{"className":"bg-slate-950 text-slate-100 font-sans antialiased selection:bg-amber-500/30 selection:text-amber-200","suppressHydrationWarning":true,"children":["$","di