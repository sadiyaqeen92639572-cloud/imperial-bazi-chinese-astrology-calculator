8:["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10","id":"symbolic-stars-page-root","children":[["$","div",null,{"className":"space-y-4","children":[["$","h1",null,{"className":"text-3xl sm:text-5xl font-serif text-slate-100 tracking-tight font-medium","children":"BaZi Symbolic Stars (Shen Sha)"}],["$","p",null,{"className":"text-sm sm:text-base text-slate-400 leading-relaxed","children":"Beyond the core Four Pillars and Ten Gods, classical BaZi layers in a set of symbolic stars (神煞 Shen Sha) that add specific life themes — romance, scholarship, and more — on top of your main chart structure."}]]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-6","children":[["$","div","peach-blossom",{"className":"bg-slate-900/60 border border-slate-850 rounded-2xl p-6 space-y-3","children":[["$","div",null,{"className":"flex items-center space-x-2 text-amber-500","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-sparkles h-5 w-5","aria-hidden":"true","children":[["$","path","1s2grr",{"d":"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"}],["$","path","1rf3ol",{"d":"M20 2v4"}],["$","path","gwowj6",{"d":"M22 4h-4"}],["$","circle","6kqj1y",{"cx":"4","cy":"20","r":"2"}],"$undefined"]}],["$","h2",null,{"className":"text-lg font-serif text-slate-100","children":["Peach Blossom Star"," ",["$","span",null,{"className":"text-slate-500 text-sm","children":["(","桃花",")"]}]]}]]}],["$","p",null,{"className":"text-xs text-slate-500","children":["Also known as: ","Tao Hua, Flower of Romance"]}],["$","p",null,{"className":"text-sm text-slate-300","children":"The Peach Blossom Star (桃花, Tao Hua) — sometimes translated as the Flower of Romance — is the classic BaZi symbolic star for charm, attraction, and romantic or social magnetism. It is derived from the Day or Year Branch and appears in a specific fixed pattern across the twelve branches."}],["$","p",null,{"className":"text-sm text-slate-400","children":"People with a strong Peach Blossom placement tend to be naturally attractive, socially fluid, and drawn toward the arts, entertainment, or any people-facing role. In a supportive chart this shows up as charisma and popularity; in a chart with conflicting or clashing elements, it can point to romantic complications or a scattered social life."}],["$","p",null,{"className":"text-xs text-slate-500 pt-2 border-t border-slate-850","children":"Peach Blossom is looked up from the Day Branch or Year Branch against a fixed table of four branch groups (each group of three branches shares one Peach Blossom branch). A qualified BaZi reading cross-references this against the rest of the chart before drawing conclusions — a single symbolic star is never read in isolation."}]]}],["$","div","academic-star",{"className":"bg-slate-900/60 border border-slate-850 rounded-2xl p-6 space-y-3","children":[["$","div",null,{"className":"flex items-center space-x-2 text-amber-500","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-graduation-cap h-5 w-5","aria-hidden":"true","children":[["$","path","j76jl0",{"d":"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"}],["$","path","1lu8f3",{"d":"M22 10v6"}],"$Lc","$undefined"]}],"$Ld"]}],"$Le","$Lf","$L10","$L11"]}]]}],"$L12","$L13"]}]
