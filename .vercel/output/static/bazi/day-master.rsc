6:Tcb2,{"@context":"https://schema.org","@type":"CollectionPage","name":"The 10 Day Masters of Chinese Astrology","description":"Explore deep profiles for the 10 Day Masters (Heavenly Stems) in Chinese astrology.","url":"https://fourpillarscalculator.com/bazi/day-master/","hasPart":[{"@type":"WebPage","position":1,"name":"Jia Wood Day Master","url":"https://fourpillarscalculator.com/bazi/day-master/jia-wood/","description":"Represented by a tall, majestic tree (such as a giant redwood or oak), Jia Wood represents upward growth, strength, leadership, and unyielding determination."},{"@type":"WebPage","position":2,"name":"Yi Wood Day Master","url":"https://fourpillarscalculator.com/bazi/day-master/yi-wood/","description":"Represented by flowers, ivy, creepers, or flexible grass, Yi Wood represents adaptability, diplomatic skill, artistic sensitivity, and resilient growth."},{"@type":"WebPage","position":3,"name":"Bing Fire Day Master","url":"https://fourpillarscalculator.com/bazi/day-master/bing-fire/","description":"Represented by the majestic Sun, Bing Fire represents warmth, clarity, boundless enthusiasm, transparency, and a vibrant public persona."},{"@type":"WebPage","position":4,"name":"Ding Fire Day Master","url":"https://fourpillarscalculator.com/bazi/day-master/ding-fire/","description":"Represented by a flickering candle, a campfire, or starlight, Ding Fire represents deep intellect, spiritual awareness, sensitivity, and quiet guidance."},{"@type":"WebPage","position":5,"name":"Wu Earth Day Master","url":"https://fourpillarscalculator.com/bazi/day-master/wu-earth/","description":"Represented by a massive mountain or high plateau, Wu Earth represents stability, trustworthiness, endurance, and quiet wisdom."},{"@type":"WebPage","position":6,"name":"Ji Earth Day Master","url":"https://fourpillarscalculator.com/bazi/day-master/ji-earth/","description":"Ji Earth — also known as Yin Earth — is represented by fertile agricultural soil, wet garden mud, or clay, and stands for nurturing, flexibility, high tolerance, and resourcefulness."},{"@type":"WebPage","position":7,"name":"Geng Metal Day Master","url":"https://fourpillarscalculator.com/bazi/day-master/geng-metal/","description":"Represented by raw steel, an axe, or unrefined iron ore, Geng Metal represents raw strength, chivalry, intense focus, and justice."},{"@type":"WebPage","position":8,"name":"Xin Metal Day Master","url":"https://fourpillarscalculator.com/bazi/day-master/xin-metal/","description":"Represented by polished jewelry, precious gems, gold coins, or delicate surgical knives, Xin Metal represents elegance, refinement, unique talent, and charisma."},{"@type":"WebPage","position":9,"name":"Ren Water Day Master","url":"https://fourpillarscalculator.com/bazi/day-master/ren-water/","description":"Represented by the mighty ocean, a roaring river, or a massive flood, Ren Water represents intelligence, freedom, dynamic movement, and charisma."},{"@type":"WebPage","position":10,"name":"Gui Water Day Master","url":"https://fourpillarscalculator.com/bazi/day-master/gui-water/","description":"Represented by gentle morning mist, rain, dew, or a clear mountain spring, Gui Water represents deep intuition, wisdom, gentleness, and mystery."}]}0:{"P":null,"b":"IbUSb_WijHZXdE_l5nHrj","p":"","c":["","bazi","day-master"],"i":false,"f":[[["",{"children":["bazi",{"children":["day-master",{"children":["__PAGE__",{}]}]}]},"$undefined","$undefined",true],["",["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/97fbd51b9f13d89c.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark scroll-smooth","children":["$","body",null,{"className":"bg-slate-950 text-slate-100 font-sans antialiased selection:bg-amber-500/30 selection:text-amber-200","suppressHydrationWarning":true,"children":["$","div",null,{"className":"flex flex-col min-h-screen","children":[["$","$L2",null,{}],["$","main",n